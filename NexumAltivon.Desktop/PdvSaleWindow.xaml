<Window x:Class="NexumAltivon.Desktop.PdvSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenesisGest.Net - Venda PDV"
        Width="1180"
        Height="700"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource ShellBackground}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="11" />
            <Setter Property="Background" Value="#0C1729" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="9" />
            <Setter Property="Background" Value="#0C1729" />
            <Setter Property="Foreground" Value="#0C1729" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
    <Grid Margin="18" MinWidth="980">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Venda balcão / PDV físico" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CodigoVenda}" Foreground="{StaticResource TextPrimary}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ContextoOperacional}" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Nova venda" Padding="18,10" Margin="0,0,10,0" Click="NovaVenda_Click" />
                    <Button Content="Salvar local" Padding="18,10" Margin="0,0,10,0" Click="SalvarLocal_Click" />
                    <Button x:Name="FinalizarVendaButton" Content="Finalizar venda" Padding="18,10" Background="{StaticResource AccentGreen}" Foreground="#08111F" FontWeight="SemiBold" BorderThickness="0" Click="FinalizarVenda_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <TextBlock Text="Cliente e operação" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                        <UniformGrid Columns="4" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Cliente" Foreground="{StaticResource TextSecondary}" />
                                <TextBox Text="{Binding BuscaCliente, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filtre os 500 clientes mais recentes por nome, e-mail ou CPF/CNPJ." />
                                <Button Content="Carregar clientes ativos" Click="CarregarClientes_Click" Padding="8,5" Margin="0,4,0,4" />
                                <ComboBox ItemsSource="{Binding ClientesPdv}" SelectedItem="{Binding ClientePdvSelecionado}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nome}" />
                                                <TextBlock Text="{Binding Cpf}" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="CPF/CNPJ" Foreground="{StaticResource TextSecondary}" />
                                <TextBox Text="{Binding ClienteDocumento}" IsReadOnly="True" />
                                <TextBlock Text="{Binding DocumentoClienteLabel}" Foreground="{StaticResource AccentAmber}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Código, CNPJ ou nome exato da empresa no Genesis" Foreground="{StaticResource TextSecondary}" />
                                <TextBox Text="{Binding EmpresaEmissora, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Entrega" Foreground="{StaticResource TextSecondary}" />
                                <ComboBox SelectedValuePath="Content" SelectedValue="{Binding TipoEntrega}">
                                    <ComboBoxItem Content="Retirada na loja" />
                                    <ComboBoxItem Content="Entrega local" />
                                    <ComboBoxItem Content="Transportadora" />
                                    <ComboBoxItem Content="Dropshipping/parceiro" />
                                </ComboBox>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelCard}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Itens da venda" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                            <UniformGrid Columns="7" Margin="0,14,0,14">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Código, SKU ou código de barras/QR" Foreground="{StaticResource TextSecondary}" />
                                    <TextBox Text="{Binding BuscaCatalogo, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Informe nome, SKU, código de barras ou conteúdo do QR Code. Leitores que enviam Enter iniciam a busca."
                                             KeyDown="BuscaCatalogo_KeyDown" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Descrição" Foreground="{StaticResource TextSecondary}" />
                                    <ComboBox ItemsSource="{Binding ProdutosCatalogo}" SelectedItem="{Binding ProdutoCatalogoSelecionado}" DisplayMemberPath="Rotulo" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Qtd." Foreground="{StaticResource TextSecondary}" />
                                    <TextBox Text="{Binding NovoItemQuantidade, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Unitário" Foreground="{StaticResource TextSecondary}" />
                                    <TextBox Text="{Binding NovoItemValorUnitario}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Custo" Foreground="{StaticResource TextSecondary}" />
                                    <TextBox Text="{Binding NovoItemCustoEstimado}" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Desconto" Foreground="{StaticResource TextSecondary}" />
                                    <TextBox Text="{Binding NovoItemDesconto, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Origem" Foreground="{StaticResource TextSecondary}" />
                                    <ComboBox SelectedValuePath="Content" SelectedValue="{Binding NovoItemOrigem}">
                                        <ComboBoxItem Content="ECOM" />
                                        <ComboBoxItem Content="DROP" />
                                        <ComboBoxItem Content="DIST" />
                                        <ComboBoxItem Content="LOJA" />
                                    </ComboBox>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Buscar catálogo" Padding="16,9" Margin="0,0,10,0" Click="BuscarCatalogo_Click" />
                                <Button Content="Adicionar item" Padding="16,9" Margin="0,0,10,0" Click="AdicionarItem_Click" />
                                <Button Content="Remover selecionado" Padding="16,9" Click="RemoverItem_Click" />
                            </StackPanel>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Itens}" SelectedItem="{Binding ItemSelecionado}" AutoGenerateColumns="False" CanUserAddRows="False" Background="#CC0C1729" Foreground="{StaticResource TextPrimary}" RowBackground="#CC0C1729" AlternatingRowBackground="#CC101B30" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource PanelBorder}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="120" />
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                                <DataGridTextColumn Header="Origem" Binding="{Binding OrigemAquisicao}" Width="90" />
                                <DataGridTextColumn Header="Qtd." Binding="{Binding Quantidade}" Width="80" />
                                <DataGridTextColumn Header="Unitário" Binding="{Binding ValorUnitario, StringFormat=N2}" Width="100" />
                                <DataGridTextColumn Header="Desconto" Binding="{Binding Desconto, StringFormat=N2}" Width="100" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="110" />
                                <DataGridTextColumn Header="Margem" Binding="{Binding MargemEstimada, StringFormat=N2}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <TextBlock Text="Pagamento" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                        <UniformGrid Columns="3" Margin="0,14,0,12">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Forma" Foreground="{StaticResource TextSecondary}" />
                                <ComboBox SelectedValuePath="Content" SelectedValue="{Binding FormaPagamento}">
                                    <ComboBoxItem Content="PIX" />
                                    <ComboBoxItem Content="Dinheiro" />
                                    <ComboBoxItem Content="Cartão crédito" />
                                    <ComboBoxItem Content="Cartão débito" />
                                    <ComboBoxItem Content="Voucher" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Valor" Foreground="{StaticResource TextSecondary}" />
                                <TextBox Text="{Binding ValorPagamento, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Autorização" Foreground="{StaticResource TextSecondary}" />
                                <TextBox Text="{Binding AutorizacaoPagamento, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                        <Button Content="Registrar pagamento" Padding="16,9" Click="RegistrarPagamento_Click" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelCard}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Resumo fiscal, financeiro e logístico" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding StatusOperacional}" Foreground="{StaticResource AccentAmber}" TextWrapping="Wrap" Margin="0,8,0,14" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Text="{Binding UltimoArquivoLocal}" Foreground="{StaticResource AccentBlue}" TextWrapping="Wrap" Margin="0,14,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding SubtotalLabel}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding DescontoLabel}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding TotalLabel}" Foreground="{StaticResource TextPrimary}" FontSize="30" FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding PagoLabel}" Foreground="{StaticResource AccentGreen}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding TrocoLabel}" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding MargemLabel}" Foreground="{StaticResource AccentAmber}" FontWeight="SemiBold" Margin="0,0,0,16" />
                            <TextBlock Text="{Binding FiscalLabel}" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding FinanceiroLabel}" Foreground="{StaticResource AccentGreen}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding LogisticaLabel}" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <ItemsControl ItemsSource="{Binding Pagamentos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#CC0C1729" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,8">
                                            <TextBlock Foreground="{StaticResource TextPrimary}">
                                                <Run Text="{Binding Forma}" />
                                                <Run Text=" - R$ " />
                                                <Run Text="{Binding Valor, StringFormat=N2}" />
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource PanelCard}">
            <TextBlock Text="Finalizar venda envia a operação à API oficial, que valida cadastro, empresa, cliente, preço, estoque e pagamentos antes de confirmar. ‘Salvar local’ registra somente um rascunho de contingência e não o sincroniza automaticamente. Emissão fiscal e abertura/fechamento de caixa exigem fluxos próprios homologados." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
