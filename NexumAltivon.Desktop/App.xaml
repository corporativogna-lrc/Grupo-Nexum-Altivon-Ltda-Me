<Application x:Class="NexumAltivon.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Shared desktop glass tone: a restrained blue-gray palette with slight
             whole-window translucency, keeping native Windows window chrome. -->
        <Style TargetType="{x:Type Window}">
            <Setter Property="Opacity" Value="0.90" />
        </Style>

        <SolidColorBrush x:Key="ShellBackground" Color="#27313D" />
        <SolidColorBrush x:Key="PanelBackground" Color="#354454" />
        <SolidColorBrush x:Key="PanelSurface" Color="#405369" />
        <SolidColorBrush x:Key="PanelElevated" Color="#4B6076" />
        <SolidColorBrush x:Key="PanelBorder" Color="#64778A" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FFF7DE" />
        <SolidColorBrush x:Key="TextSecondary" Color="#D6E0EA" />
        <SolidColorBrush x:Key="TextMuted" Color="#AAB8C6" />
        <SolidColorBrush x:Key="AccentBlue" Color="#D7B528" />
        <SolidColorBrush x:Key="AccentGold" Color="#D7B528" />
        <SolidColorBrush x:Key="AccentGoldDark" Color="#9A7413" />
        <SolidColorBrush x:Key="AccentGreen" Color="#2F9E44" />
        <SolidColorBrush x:Key="AccentAmber" Color="#E6A817" />
        <SolidColorBrush x:Key="AccentRose" Color="#D95C4B" />
        <SolidColorBrush x:Key="AccentViolet" Color="#A782D9" />

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="11" />
            <Setter Property="Background" Value="{StaticResource PanelSurface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentGold}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentGoldDark}" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="11" />
            <Setter Property="Background" Value="{StaticResource PanelSurface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentGold}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="9" />
            <Setter Property="Background" Value="{StaticResource PanelSurface}" />
            <Setter Property="Foreground" Value="#101010" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Background" Value="{StaticResource PanelElevated}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource AccentGold}" />
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource PanelBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.52" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource AccentGold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Resources>
</Application>
