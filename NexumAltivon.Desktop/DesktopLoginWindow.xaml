<Window x:Class="NexumAltivon.Desktop.DesktopLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenesisGest.Net - Acesso ao Desktop"
        Width="760" Height="620" MinWidth="640" MinHeight="540"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ShellBackground}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Border MaxWidth="620" Padding="42" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1" CornerRadius="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="GENESISGEST.NET  •  NEXUM ALTIVON" Foreground="{StaticResource AccentGold}" FontSize="13" FontWeight="Bold" />
                <TextBlock Grid.Row="1" Text="Acesso ao sistema" Foreground="{StaticResource TextPrimary}" FontSize="32" FontWeight="Bold" Margin="0,10,0,0" />
                <TextBlock Grid.Row="2" Text="Entre com a conta autorizada para abrir o ERP e o PDV." Foreground="{StaticResource TextSecondary}" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,24" />
                <StackPanel Grid.Row="3">
                    <TextBlock Text="E-mail corporativo" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,7" />
                    <TextBox x:Name="EmailBox" MaxLength="254" Height="44" />
                </StackPanel>
                <StackPanel Grid.Row="4" Margin="0,18,0,0">
                    <TextBlock Text="Senha" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PasswordInput" Height="44" KeyDown="PasswordInput_KeyDown" />
                        <TextBox x:Name="VisiblePasswordInput" Height="44" Visibility="Collapsed" KeyDown="VisiblePasswordInput_KeyDown" />
                        <Button x:Name="TogglePasswordButton" Grid.Column="2" Content="Mostrar" Padding="14,8" Click="TogglePassword_Click" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="5" Margin="0,16,0,0">
                    <TextBlock Text="Código MFA (quando exigido pela conta)" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,7" />
                    <TextBox x:Name="MfaBox" MaxLength="8" Height="44" />
                </StackPanel>
                <CheckBox x:Name="KeepPasswordCheckBox" Grid.Row="6" Content="Manter senha salva neste computador"
                          Foreground="{StaticResource TextSecondary}" Margin="0,14,0,0" Unchecked="KeepPasswordCheckBox_Unchecked" />
                <StackPanel Grid.Row="7" Margin="0,24,0,0">
                    <TextBlock x:Name="StatusText" Text="A sessão será validada na API antes de abrir o sistema."
                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MinHeight="36" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Sair" Padding="22,10" Margin="0,0,10,0" Click="Sair_Click" />
                        <Button x:Name="EntrarButton" Content="Entrar" Background="{StaticResource AccentGold}"
                                Foreground="#080704" FontWeight="Bold" Padding="28,10" Click="Entrar_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
