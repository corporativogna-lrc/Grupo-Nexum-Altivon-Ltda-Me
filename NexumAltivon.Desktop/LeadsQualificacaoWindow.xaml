<Window x:Class="NexumAltivon.Desktop.LeadsQualificacaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenesisGest.Net - Leads e qualificação"
        Width="1240"
        Height="780"
        MinWidth="1020"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ShellBackground}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CRM" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="Leads e qualificação" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="24" Margin="0,4,0,0" />
                    <TextBlock Text="Consulta e atualização de status persistidas no tenant atual pela API oficial." Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Gerente" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Busca" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Status" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding StatusFiltroOpcoes}" SelectedItem="{Binding StatusFiltro, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Atualizar" Click="Atualizar_Click" MinWidth="110" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="Limpar" Click="Limpar_Click" MinWidth="90" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding LeadsVisiveis}"
                      SelectedItem="{Binding LeadSelecionado, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      Background="{StaticResource PanelSurface}"
                      Foreground="{StaticResource TextPrimary}"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding Id}" Width="80" />
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                    <DataGridTextColumn Header="Empresa" Binding="{Binding Empresa}" Width="170" />
                    <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="220" />
                    <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="130" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />
                    <DataGridTextColumn Header="Criado em" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Resumo}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="14,0,12,0">
                    <TextBlock Text="Novo status" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding StatusOpcoes}" SelectedItem="{Binding NovoStatus, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Gravar status" Click="GravarStatus_Click" MinWidth="120" VerticalAlignment="Bottom" />
            </Grid>
        </Border>
    </Grid>
</Window>
