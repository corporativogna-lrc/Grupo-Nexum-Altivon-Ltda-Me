<!--
 * Propriedade intelectual: Luís Rodrigo da Costa
 * Com apoio: IA Chatgpt/Codex que atende por nome: Sophia
 * Sistema de gestão: GenesisGest.Net
 * Ano Início: 04/2024 Publicado e operacional: 05/2026
 * Versão: 1.1.5
 -->
<Window x:Class="NexumAltivon.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NexumAltivon.Desktop.Models"
        Title="GenesisGest.Net - Central Desktop ERP/PDV"
        Width="1280"
        Height="720"
        MinWidth="980"
        MinHeight="640"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ShellBackground}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="SectionKicker" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentGold}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentGold}" />
            <Setter Property="Foreground" Value="#080704" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PanelSurface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,7" />
            <Style.Triggers>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Foreground" Value="#080704" />
                    <Setter Property="Background" Value="#F4E7B8" />
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Foreground" Value="#080704" />
                    <Setter Property="Background" Value="#F4E7B8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="OperationActionTemplate">
            <Button Click="WorkstationAction_Click"
                    Tag="{Binding}"
                    Background="{StaticResource PanelSurface}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,0,12,12">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Accent}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentGold}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="EnterpriseModuleTemplate">
            <Button Click="ModuleCard_Click"
                    Tag="{Binding}"
                    Background="{StaticResource PanelSurface}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,0,12,12">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Accent}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentGreen}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="20">
        <Menu DockPanel.Dock="Top"
              Background="{StaticResource PanelBackground}"
              Foreground="{StaticResource TextPrimary}"
              BorderBrush="{StaticResource PanelBorder}"
              BorderThickness="1"
              Padding="8"
              Margin="0,0,0,14">
            <MenuItem Header="_Operação">
                <MenuItem Header="Abrir PDV / Venda de balcão" Click="OpenPdvSale_Click" />
                <MenuItem Header="Abrir caixa" Click="OpenPdvSale_Click" />
                <MenuItem Header="Fechar caixa" Click="OpenPdvSale_Click" />
                <Separator />
                <MenuItem Header="Troca e devolução" Click="OpenPdvSale_Click" />
                <MenuItem Header="Consulta de pedido" Click="OpenWorkspace_Click" />
            </MenuItem>
            <MenuItem Header="_Cadastros">
                <MenuItem Header="Clientes" Click="OpenWorkspace_Click" />
                <MenuItem Header="Fornecedores" Click="OpenWorkspace_Click" />
                <MenuItem Header="Produtos e serviços" Click="OpenWorkspace_Click" />
                <MenuItem Header="Categorias e subcategorias" Click="OpenWorkspace_Click" />
                <MenuItem Header="Empresas do grupo" Click="OpenWorkspace_Click" />
                <MenuItem Header="Centros de custo" Click="OpenWorkspace_Click" />
                <MenuItem Header="Usuários, perfis e permissões" Click="OpenAccessManagement_Click" />
            </MenuItem>
            <MenuItem Header="_Compras">
                <MenuItem Header="Solicitação de compra" Click="OpenWorkspace_Click" />
                <MenuItem Header="Cotação com fornecedores" Click="OpenWorkspace_Click" />
                <MenuItem Header="Pedido de compra" Click="OpenWorkspace_Click" />
                <MenuItem Header="Entrada de mercadoria" Click="OpenWorkspace_Click" />
                <MenuItem Header="Dropshipping e parcerias" Click="OpenWorkspace_Click" />
                <MenuItem Header="Devolução a fornecedor" Click="OpenWorkspace_Click" />
            </MenuItem>
            <MenuItem Header="_Estoque">
                <MenuItem Header="Saldo físico" Click="OpenWorkspace_Click" />
                <MenuItem Header="Saldo fiscal" Click="OpenWorkspace_Click" />
                <MenuItem Header="Transferência entre lojas" Click="OpenWorkspace_Click" />
                <MenuItem Header="Inventário" Click="OpenWorkspace_Click" />
                <MenuItem Header="Código de barras e QR Code" Click="OpenWorkspace_Click" />
                <MenuItem Header="Rastreabilidade por origem" Click="OpenWorkspace_Click" />
            </MenuItem>
            <MenuItem Header="_Retaguarda">
                <MenuItem Header="Painel Genesis local" Click="OpenWorkspace_Click" />
                <MenuItem Header="Cockpit executivo" Click="OpenWorkspace_Click" />
                <MenuItem Header="Comercial e CRM" Click="OpenWorkspace_Click" />
                <MenuItem Header="Relatórios gerenciais" Click="OpenWorkspace_Click" />
                <MenuItem Header="Auditoria operacional" Click="OpenWorkspace_Click" />
            </MenuItem>
            <MenuItem Header="_Financeiro">
                <MenuItem Header="Contas a receber" Click="OpenWorkspace_Click" />
                <MenuItem Header="Contas a pagar" Click="OpenWorkspace_Click" />
                <MenuItem Header="Caixa e conciliação" Click="OpenWorkspace_Click" />
                <MenuItem Header="Tesouraria" Click="OpenWorkspace_Click" />
                <MenuItem Header="Alçadas de aprovação" Click="OpenWorkspace_Click" />
                <MenuItem Header="Conciliação bancária" Click="OpenWorkspace_Click" />
                <MenuItem Header="Ativo imobilizado" Click="OpenWorkspace_Click" />
                <MenuItem Header="DRE e indicadores" Click="OpenWorkspace_Click" />
            </MenuItem>
            <MenuItem Header="_Fiscal">
                <MenuItem Header="Emissão fiscal manual" Click="OpenManualNfe_Click" />
                <MenuItem Header="Contingência fiscal" Click="OpenManualNfe_Click" />
                <MenuItem Header="Empresa emissora automática" Click="OpenWorkspace_Click" />
                <MenuItem Header="Regras fiscais do grupo" Click="OpenWorkspace_Click" />
                <MenuItem Header="NF-e / NFC-e / SAT" Click="OpenManualNfe_Click" />
                <MenuItem Header="SPED / EFD / REINF" Click="OpenWorkspace_Click" />
                <MenuItem Header="Tributos e retenções" Click="OpenWorkspace_Click" />
            </MenuItem>
            <MenuItem Header="_Logística">
                <MenuItem Header="Coleta" Click="OpenWorkspace_Click" />
                <MenuItem Header="Entrega" Click="OpenWorkspace_Click" />
                <MenuItem Header="Rastreamento" Click="OpenWorkspace_Click" />
                <MenuItem Header="Transportadoras" Click="OpenWorkspace_Click" />
                <MenuItem Header="Status do pedido" Click="OpenWorkspace_Click" />
                <MenuItem Header="Comunicação ao cliente" Click="OpenWorkspace_Click" />
            </MenuItem>
            <MenuItem Header="_Integrações">
                <MenuItem Header="API local do servidor" Click="RefreshStatus_Click" />
                <MenuItem Header="API pública Cloudflare" Click="RefreshStatus_Click" />
                <MenuItem Header="E-commerce e dropshipping" Click="OpenWorkspace_Click" />
                <MenuItem Header="Logística e rastreio" Click="OpenWorkspace_Click" />
                <MenuItem Header="Marketplaces" Click="OpenWorkspace_Click" />
                <MenuItem Header="Open Finance / bancos" Click="OpenWorkspace_Click" />
                <MenuItem Header="WhatsApp e e-mail" Click="OpenWorkspace_Click" />
                <MenuItem Header="Chaves OpenAI - Yara e Sophia" Click="OpenNetworkSettings_Click" />
            </MenuItem>
            <MenuItem Header="_Governança">
                <MenuItem Header="RBAC e perfis" Click="OpenWorkspace_Click" />
                <MenuItem Header="Trilha de auditoria" Click="OpenWorkspace_Click" />
                <MenuItem Header="LGPD" Click="OpenWorkspace_Click" />
                <MenuItem Header="Workflow e aprovações" Click="OpenWorkspace_Click" />
                <MenuItem Header="Multiempresa e tenant" Click="OpenWorkspace_Click" />
            </MenuItem>
            <MenuItem Header="_HCM / RH">
                <MenuItem Header="Colaboradores / RH / folha" Click="OpenWorkspace_Click" />
                <MenuItem Header="Contratações" Click="OpenWorkspace_Click" />
                <MenuItem Header="Demissões" Click="OpenWorkspace_Click" />
                <MenuItem Header="Cargos e departamentos" Click="OpenWorkspace_Click" />
                <MenuItem Header="Ponto e jornada" Click="OpenWorkspace_Click" />
            </MenuItem>
            <MenuItem Header="_Sistema">
                <MenuItem Header="Atualizar conexões" Click="RefreshStatus_Click" />
                <MenuItem Header="Grade de rede e endpoints" Click="OpenNetworkSettings_Click" />
                <MenuItem Header="Configurar terminal" Click="FocusTerminal_Click" />
                <MenuItem Header="Abrir pasta de contingência" Click="OpenOutboxFolder_Click" />
            </MenuItem>
        </Menu>

        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="14">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource AccentGold}" Margin="0,0,10,0">
                                <TextBlock Text="NA" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#070604" FontSize="18" FontWeight="Black" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Grupo Nexum Altivon" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="GENESISGEST.NET" Foreground="{StaticResource AccentGold}" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Terminal operacional" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,14,0,10" />
                        <Button Content="Abrir painel Genesis local" Style="{StaticResource PrimaryButton}" Height="38" Padding="10,6" Click="OpenWorkspace_Click" Margin="0,0,0,7" />
                        <Button Content="Atualizar conexões" Style="{StaticResource GhostButton}" Height="38" Padding="10,6" Click="RefreshStatus_Click" Margin="0,0,0,7" />
                        <Button Content="Grade de rede e endpoints" Style="{StaticResource GhostButton}" Height="38" Padding="10,6" Click="OpenNetworkSettings_Click" Margin="0,0,0,7" />
                        <Button Content="Emissão fiscal manual" Style="{StaticResource GhostButton}" Height="38" Padding="10,6" Click="OpenManualNfe_Click" />
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelSurface}" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="CONEXÃO DO TERMINAL" Foreground="{StaticResource AccentGold}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="{Binding EnvironmentStatus}" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding EnvironmentDetail}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" MaxHeight="42" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding Terminal.StoreName}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Terminal.TerminalCode}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CENTRAL OPERACIONAL" Style="{StaticResource SectionKicker}" />
                            <TextBlock Text="ERP e PDV · visão geral" Foreground="{StaticResource TextPrimary}" FontSize="24" FontWeight="Bold" Margin="0,3,0,0" />
                            <TextBlock Text="Operação de lojas, caixa, retaguarda e integrações." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                            <TextBlock Text="{Binding ConnectionModeLabel}" Foreground="{StaticResource AccentGreen}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding ServerDatabaseLabel}" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" Margin="0,3,0,0" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding LastUpdatedLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <UniformGrid Grid.Row="1" Columns="4" Rows="1" Margin="0,10,0,10">
                    <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="{Binding SalesMetricValue}" Style="{StaticResource MetricValue}" FontSize="22" /><TextBlock Text="Atendimento e caixa" Style="{StaticResource MetricLabel}" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="{Binding FiscalMetricValue}" Style="{StaticResource MetricValue}" FontSize="22" /><TextBlock Text="Fiscal e contingência" Style="{StaticResource MetricLabel}" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="{Binding GroupMetricValue}" Style="{StaticResource MetricValue}" FontSize="22" /><TextBlock Text="Empresa e filial" Style="{StaticResource MetricLabel}" /></StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Padding="12">
                        <StackPanel><TextBlock Text="{Binding IntegrationMetricValue}" Style="{StaticResource MetricValue}" FontSize="22" /><TextBlock Text="Servidor e integrações" Style="{StaticResource MetricLabel}" /></StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Áreas de trabalho" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,0,0,10" />
                        <UniformGrid Grid.Row="1" Columns="3" Rows="2">
                            <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,8,8">
                                <StackPanel><TextBlock Text="Vendas e PDV" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" /><TextBlock Text="Venda de balcão, caixa e pedidos." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,8,8">
                                <StackPanel><TextBlock Text="Financeiro" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" /><TextBlock Text="Contas, tesouraria e conciliação." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                <StackPanel><TextBlock Text="Compras e estoque" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" /><TextBlock Text="Cotações, entradas e saldos." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="Fiscal" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" /><TextBlock Text="Empresas emitentes e contingência." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="Logística" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" /><TextBlock Text="Coletas, entregas e rastreamento." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="12">
                                <StackPanel><TextBlock Text="Integrações" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" /><TextBlock Text="API local, nuvem e serviços conectados." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
