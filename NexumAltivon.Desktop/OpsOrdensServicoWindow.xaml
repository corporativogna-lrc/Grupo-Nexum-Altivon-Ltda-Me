<Window x:Class="NexumAltivon.Desktop.OpsOrdensServicoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenesisGest.Net - Ordens de serviço"
        Width="1440"
        Height="860"
        MinWidth="1200"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ShellBackground}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentGold}" />
            <Setter Property="Foreground" Value="#080704" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PanelSurface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MES / OPS / ORDEM DE SERVIÇO" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="Ordens de serviço" Foreground="{StaticResource TextPrimary}" FontSize="25" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Abertura, acompanhamento, custos, tempos e itens da ordem usando o contrato oficial da API." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxWidth="470" HorizontalAlignment="Right" />
                    <Button Content="Recarregar ordens" Style="{StaticResource SecondaryButton}" Click="Carregar_Click" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ordens persistidas" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="A exclusão usa soft-delete no tenant atual." Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="StatusFiltroBox" Grid.Column="1" SelectionChanged="StatusFiltro_Changed" VerticalAlignment="Center">
                            <ComboBoxItem Content="Todos" IsSelected="True" />
                            <ComboBoxItem Content="ABERTA" />
                            <ComboBoxItem Content="EM_ANDAMENTO" />
                            <ComboBoxItem Content="CONCLUIDA" />
                            <ComboBoxItem Content="CANCELADA" />
                        </ComboBox>
                    </Grid>
                    <DataGrid x:Name="OrdensGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding Ordens}"
                              SelectionChanged="OrdensGrid_SelectionChanged"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              BorderBrush="{StaticResource PanelBorder}"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="1.2*" />
                            <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="2*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.2*" />
                            <DataGridTextColumn Header="Prioridade" Binding="{Binding Prioridade}" Width="1.1*" />
                            <DataGridTextColumn Header="Abertura" Binding="{Binding DataAbertura, StringFormat=dd/MM/yyyy HH:mm}" Width="1.5*" />
                            <DataGridTextColumn Header="Custo real" Binding="{Binding CustoReal, StringFormat=R$ {0:N2}}" Width="1.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Cabeçalho transacional" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="O salvamento inclui o cabeçalho e os itens da ordem no contrato oficial." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Número" Style="{StaticResource Label}" />
                                <TextBox x:Name="NumeroBox" Margin="0,0,0,10" MaxLength="50" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ativo vinculado" Style="{StaticResource Label}" />
                                <ComboBox x:Name="AtivoBox" ItemsSource="{Binding Ativos}" SelectedValuePath="Id" SelectedValue="{Binding SelectedAtivoId, Mode=TwoWay}" Margin="0,0,0,10">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Codigo}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Título" Style="{StaticResource Label}" />
                        <TextBox x:Name="TituloBox" Margin="0,0,0,10" MaxLength="180" />
                        <TextBlock Text="Descrição" Style="{StaticResource Label}" />
                        <TextBox x:Name="DescricaoBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Status" Style="{StaticResource Label}" />
                                <ComboBox x:Name="StatusBox" Margin="0,0,0,10">
                                    <ComboBoxItem Content="ABERTA" IsSelected="True" />
                                    <ComboBoxItem Content="EM_ANDAMENTO" />
                                    <ComboBoxItem Content="CONCLUIDA" />
                                    <ComboBoxItem Content="CANCELADA" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Prioridade" Style="{StaticResource Label}" />
                                <ComboBox x:Name="PrioridadeBox" Margin="0,0,0,10">
                                    <ComboBoxItem Content="BAIXA" />
                                    <ComboBoxItem Content="NORMAL" IsSelected="True" />
                                    <ComboBoxItem Content="ALTA" />
                                    <ComboBoxItem Content="URGENTE" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Data de abertura" Style="{StaticResource Label}" />
                                <DatePicker x:Name="DataAberturaPicker" Margin="0,0,0,10" />
                                <TextBlock Text="Data prevista" Style="{StaticResource Label}" />
                                <DatePicker x:Name="DataPrevistaPicker" Margin="0,0,0,10" />
                                <TextBlock Text="Tempo estimado (min)" Style="{StaticResource Label}" />
                                <TextBox x:Name="TempoEstimadoBox" Margin="0,0,0,10" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data de conclusão" Style="{StaticResource Label}" />
                                <DatePicker x:Name="DataConclusaoPicker" Margin="0,0,0,10" />
                                <TextBlock Text="Tempo real (min)" Style="{StaticResource Label}" />
                                <TextBox x:Name="TempoRealBox" Margin="0,0,0,10" />
                                <TextBlock Text="Responsável (ID)" Style="{StaticResource Label}" />
                                <TextBox x:Name="ResponsavelBox" Margin="0,0,0,10" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Custo previsto" Style="{StaticResource Label}" />
                                <TextBox x:Name="CustoPrevistoBox" Margin="0,0,0,10" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Custo real" Style="{StaticResource Label}" />
                                <TextBox x:Name="CustoRealBox" Margin="0,0,0,10" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Itens / serviços" Style="{StaticResource Label}" />
                        <DataGrid x:Name="ItensGrid" ItemsSource="{Binding Itens}" AutoGenerateColumns="False" CanUserAddRows="False" Height="150" Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo, UpdateSourceTrigger=PropertyChanged}" Width="0.8*" />
                                <DataGridTextColumn Header="Código" Binding="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" Width="1*" />
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridTextColumn Header="Qtd." Binding="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" Width="0.8*" />
                                <DataGridTextColumn Header="Un." Binding="{Binding Unidade, UpdateSourceTrigger=PropertyChanged}" Width="0.7*" />
                                <DataGridTextColumn Header="Custo" Binding="{Binding CustoUnitario, UpdateSourceTrigger=PropertyChanged}" Width="1*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel>
                            <Button Content="Adicionar item" Style="{StaticResource SecondaryButton}" Click="AdicionarItem_Click" />
                            <Button Content="Remover item" Style="{StaticResource SecondaryButton}" Click="RemoverItem_Click" />
                        </WrapPanel>

                        <TextBlock Text="Observações" Style="{StaticResource Label}" />
                        <TextBox x:Name="ObservacoesBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14" />
                        <WrapPanel>
                            <Button Content="Novo" Style="{StaticResource SecondaryButton}" Click="Novo_Click" />
                            <Button Content="Salvar ordem" Style="{StaticResource PrimaryButton}" Click="Salvar_Click" />
                            <Button Content="Excluir ordem" Style="{StaticResource SecondaryButton}" Click="Excluir_Click" />
                        </WrapPanel>
                        <Border Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Contexto" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedDetails}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
