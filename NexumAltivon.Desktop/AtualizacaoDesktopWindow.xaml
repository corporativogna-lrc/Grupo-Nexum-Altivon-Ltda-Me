<Window x:Class="NexumAltivon.Desktop.AtualizacaoDesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenesisGest.Net - Atualização do Desktop"
        Width="720" Height="460" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource ShellBackground}"
        FontFamily="Segoe UI"
        Closed="Window_Closed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="S20 · SISTEMA" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold" />
            <TextBlock Text="Atualização do Desktop" Foreground="{StaticResource TextPrimary}" FontSize="26" FontWeight="Bold" Margin="0,5,0,0" />
            <TextBlock Text="Consulte a release oficial do GitHub e baixe um instalador compatível." Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Versão instalada" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="{Binding CurrentVersion}" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Release encontrada" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="{Binding LatestVersion}" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="4" Text="{Binding DownloadedFile}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Verificar e baixar" MinWidth="150" Padding="16,10" Margin="0,0,10,0" IsEnabled="{Binding CanCheck}" Click="CheckAndDownload_Click" Background="{StaticResource AccentGold}" Foreground="#0A0A0A" FontWeight="SemiBold" />
                    <Button Content="Iniciar instalador" MinWidth="150" Padding="16,10" IsEnabled="{Binding CanInstall}" Click="Install_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
