 * Propriedade intelectual: Luís Rodrigo da Costa
 * Patch LURCO432 — PlanoContasWindow (cópia em triagem, sem integração com API real)
 * Sistema de gestão: GenesisGest.Net
 * Versão: 1.1.5.7200
 * Setor: S05 | Código: A-241-F01 | Endpoint: /api/contabil/plano-contas
 -->
<!-- Patch LURCO432 (Em Triagem): COMPILA mas NÃO funciona contra API real. Endpoint declarado no cabeçalho do code-behind. -->
<Window x:Class="NexumAltivon.Desktop.PlanoContasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenesisGest.Net - Plano de contas"
        Width="1220" Height="760" MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource ShellBackground}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Cabeçalho -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="S05" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="Plano de contas" Foreground="{StaticResource TextPrimary}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding BuscaResultado}" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxWidth="340" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- Corpo: busca + formulário -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>
            <!-- Busca filtrada (read-only) -->
            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Buscar" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBox x:Name="BuscaBox" TextChanged="BuscaChanged" Margin="0,0,0,8" />
                    <DataGrid x:Name="ResultadosGrid"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionChanged="Resultados_SelectionChanged"
                              ItemsSource="{Binding Resultados}"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              BorderBrush="{StaticResource PanelBorder}"
                              BorderThickness="1"
                              MaxHeight="500" />
                </StackPanel>
            </Border>
            <!-- Formulário específico -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Formulário" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Código" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RegistroSelecionado.Codigo}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Descrição" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RegistroSelecionado.Descricao}" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Status" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding RegistroSelecionado.Status}">
                                <ComboBoxItem Content="Ativo" />
                                <ComboBoxItem Content="Inativo" />
                                <ComboBoxItem Content="Pendente" />
                            </ComboBox>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Observação" VerticalAlignment="Center" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding RegistroSelecionado.Observacao}" TextWrapping="Wrap" AcceptsReturn="True" Height="80" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Salvar" Click="Salvar_Click" Background="{StaticResource AccentGold}" Foreground="#0A0A0A" FontWeight="Bold" Margin="0,0,8,0" />
                            <Button Content="Excluir" Click="Excluir_Click" Background="{StaticResource AccentRose}" Foreground="White" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
