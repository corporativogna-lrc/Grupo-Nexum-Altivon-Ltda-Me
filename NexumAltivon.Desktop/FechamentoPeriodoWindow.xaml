<Window x:Class="NexumAltivon.Desktop.FechamentoPeriodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenesisGest.Net - Fechamento contábil"
        Width="1380"
        Height="840"
        MinWidth="1100"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ShellBackground}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Section}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="FICO / CONTABILIDADE" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold" />
                    <TextBlock Text="Fechamento contábil por período" Foreground="{StaticResource TextPrimary}" FontSize="25" FontWeight="Bold" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="{Binding CodigoContexto}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                        <TextBlock Text="  |  " Foreground="{StaticResource TextMuted}" />
                        <TextBlock Text="{Binding TenantLabel}" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="  |  " Foreground="{StaticResource TextMuted}" />
                        <TextBlock Text="{Binding EstadoContexto}" Foreground="{StaticResource AccentGreen}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Novo período" Click="Novo_Click" IsEnabled="{Binding PodeOperar}" Margin="0,0,8,0" />
                    <Button Content="Recarregar" Click="Recarregar_Click" IsEnabled="{Binding PodeOperar}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Fechamento">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.72*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.28*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Dados do período" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="Empresa" Style="{StaticResource Label}" Margin="0,16,0,5" />
                            <TextBox Text="{Binding EmpresaIdText, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" />
                            <TextBlock Text="Competência" Style="{StaticResource Label}" Margin="0,12,0,5" />
                            <DatePicker SelectedDate="{Binding Periodo}" />
                            <CheckBox Content="Período bloqueado para novos lançamentos" IsChecked="{Binding Bloqueado}" Foreground="{StaticResource TextPrimary}" Margin="0,16,0,0" />
                            <TextBlock Text="Observações" Style="{StaticResource Label}" Margin="0,16,0,5" />
                            <TextBox Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" AcceptsReturn="True" Height="100" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Validacao}" Foreground="{StaticResource AccentAmber}" TextWrapping="Wrap" Margin="0,14,0,0" />
                            <Button Content="Registrar fechamento" Click="Salvar_Click" Background="{StaticResource AccentGreen}" Margin="0,18,0,0" IsEnabled="{Binding PodeOperar}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Section}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="Fechamentos registrados" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="{Binding FechamentosLabel}" Foreground="{StaticResource TextSecondary}" DockPanel.Dock="Right" />
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Fechamentos}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,12,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                                    <DataGridTextColumn Header="Empresa" Binding="{Binding EmpresaId}" Width="80" />
                                    <DataGridTextColumn Header="Competência" Binding="{Binding Periodo, StringFormat=MM/yyyy}" Width="100" />
                                    <DataGridTextColumn Header="Fechado em" Binding="{Binding DataFechamento, StringFormat=dd/MM/yyyy HH:mm}" Width="140" />
                                    <DataGridCheckBoxColumn Header="Bloqueado" Binding="{Binding Bloqueado}" Width="90" />
                                    <DataGridTextColumn Header="Observações" Binding="{Binding Observacoes}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Trilha de auditoria">
                <Border Style="{StaticResource Section}" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Auditoria de cnt_fechamentos" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Auditoria}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,12,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="150" />
                                <DataGridTextColumn Header="Registro" Binding="{Binding RegistroId}" Width="85" />
                                <DataGridTextColumn Header="Ação" Binding="{Binding Acao}" Width="100" />
                                <DataGridTextColumn Header="Usuário" Binding="{Binding UsuarioId}" Width="85" />
                                <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4" Style="{StaticResource Section}">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
