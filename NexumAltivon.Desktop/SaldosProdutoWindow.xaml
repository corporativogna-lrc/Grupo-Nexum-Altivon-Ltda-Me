<Window x:Class="NexumAltivon.Desktop.SaldosProdutoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenesisGest.Net - Saldo físico por produto"
        Width="1080"
        Height="700"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ShellBackground}"
        FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="ESTOQUE · GENESIS" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold" />
            <TextBlock Text="Saldo físico por produto" Foreground="{StaticResource TextPrimary}" FontSize="30" FontWeight="Bold" Margin="0,5,0,0" />
            <TextBlock Text="Consulta somente leitura da empresa vinculada ao tenant autenticado." Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="BuscaBox"
                     VerticalContentAlignment="Center"
                     ToolTip="Pesquisar por SKU ou descrição"
                     KeyDown="BuscaBox_KeyDown" />
            <Button Grid.Column="2"
                    Content="Atualizar saldo"
                    Padding="18,10"
                    Background="{StaticResource AccentGold}"
                    Foreground="#080704"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="AtualizarSaldo_Click" />
        </Grid>

        <DataGrid Grid.Row="2"
                  x:Name="ResultadosGrid"
                  ItemsSource="{Binding Saldos}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{StaticResource PanelBackground}"
                  Foreground="{StaticResource TextPrimary}"
                  BorderBrush="{StaticResource PanelBorder}"
                  RowBackground="{StaticResource PanelBackground}"
                  AlternatingRowBackground="{StaticResource PanelSurface}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="150" />
                <DataGridTextColumn Header="Produto" Binding="{Binding Produto}" Width="*" MinWidth="220" />
                <DataGridTextColumn Header="Físico" Binding="{Binding QuantidadeFisica, StringFormat=N3}" Width="120" />
                <DataGridTextColumn Header="Reservado" Binding="{Binding QuantidadeReservada, StringFormat=N3}" Width="120" />
                <DataGridTextColumn Header="Disponível" Binding="{Binding QuantidadeDisponivel, StringFormat=N3}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button DockPanel.Dock="Right"
                    Content="Fechar"
                    Padding="18,9"
                    Margin="12,0,0,0"
                    Background="{StaticResource PanelSurface}"
                    Foreground="{StaticResource TextPrimary}"
                    BorderBrush="{StaticResource PanelBorder}"
                    Click="Fechar_Click" />
        </DockPanel>
    </Grid>
</Window>
