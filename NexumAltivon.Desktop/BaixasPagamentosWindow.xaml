<Window x:Class="NexumAltivon.Desktop.BaixasPagamentosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GenesisGest.Net - Baixas financeiras"
        Width="1380"
        Height="840"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ShellBackground}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Section}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="FICO / BAIXAS" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold" />
                    <TextBlock Text="Baixas financeiras" Foreground="{StaticResource TextPrimary}" FontSize="25" FontWeight="Bold" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="{Binding CodigoContexto}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                        <TextBlock Text="  |  " Foreground="{StaticResource TextMuted}" />
                        <TextBlock Text="{Binding TenantLabel}" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="  |  " Foreground="{StaticResource TextMuted}" />
                        <TextBlock Text="{Binding EstadoContexto}" Foreground="{StaticResource AccentGreen}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Recarregar" Click="Recarregar_Click" IsEnabled="{Binding PodeOperar}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Baixa de contas a pagar">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="0.75*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Section}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="Títulos a pagar" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="{Binding ContasPagarLabel}" Foreground="{StaticResource TextSecondary}" DockPanel.Dock="Right" />
                            </DockPanel>
                            <DataGrid x:Name="ContasPagarGrid" Grid.Row="1" ItemsSource="{Binding ContasPagar}" SelectedItem="{Binding SelectedContaPagar}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Margin="0,12,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Documento" Binding="{Binding NumeroDocumento}" Width="130" />
                                    <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                                    <DataGridTextColumn Header="Vencimento" Binding="{Binding DataVencimento, StringFormat=dd/MM/yyyy}" Width="95" />
                                    <DataGridTextColumn Header="Aberto" Binding="{Binding ValorAberto, StringFormat=N2}" Width="90" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Registrar baixa a pagar" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding ContaPagarSelecionadaLabel}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,14,0,0" />
                            <TextBlock Text="Valor pago" Style="{StaticResource Label}" Margin="0,16,0,5" />
                            <TextBox Text="{Binding ValorPagar, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Data do pagamento" Style="{StaticResource Label}" Margin="0,12,0,5" />
                            <DatePicker SelectedDate="{Binding DataPagar}" />
                            <TextBlock Text="Forma de pagamento" Style="{StaticResource Label}" Margin="0,12,0,5" />
                            <TextBox Text="{Binding FormaPagar, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" />
                            <TextBlock Text="Observações" Style="{StaticResource Label}" Margin="0,12,0,5" />
                            <TextBox Text="{Binding ObservacoesPagar, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ValidacaoPagar}" Foreground="{StaticResource AccentAmber}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <Button Content="Confirmar baixa" Click="BaixarPagar_Click" Background="{StaticResource AccentGreen}" Margin="0,18,0,0" IsEnabled="{Binding PodeOperar}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Baixa de contas a receber">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="0.75*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Section}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="Títulos a receber" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="{Binding ContasReceberLabel}" Foreground="{StaticResource TextSecondary}" DockPanel.Dock="Right" />
                            </DockPanel>
                            <DataGrid x:Name="ContasReceberGrid" Grid.Row="1" ItemsSource="{Binding ContasReceber}" SelectedItem="{Binding SelectedContaReceber}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Margin="0,12,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Documento" Binding="{Binding NumeroDocumento}" Width="130" />
                                    <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*" />
                                    <DataGridTextColumn Header="Vencimento" Binding="{Binding DataVencimento, StringFormat=dd/MM/yyyy}" Width="95" />
                                    <DataGridTextColumn Header="Aberto" Binding="{Binding ValorAberto, StringFormat=N2}" Width="90" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="Registrar baixa a receber" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding ContaReceberSelecionadaLabel}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,14,0,0" />
                            <TextBlock Text="Valor recebido" Style="{StaticResource Label}" Margin="0,16,0,5" />
                            <TextBox Text="{Binding ValorReceber, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Data do recebimento" Style="{StaticResource Label}" Margin="0,12,0,5" />
                            <DatePicker SelectedDate="{Binding DataReceber}" />
                            <TextBlock Text="Forma de recebimento" Style="{StaticResource Label}" Margin="0,12,0,5" />
                            <TextBox Text="{Binding FormaReceber, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" />
                            <TextBlock Text="Observações" Style="{StaticResource Label}" Margin="0,12,0,5" />
                            <TextBox Text="{Binding ObservacoesReceber, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ValidacaoReceber}" Foreground="{StaticResource AccentAmber}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <Button Content="Confirmar recebimento" Click="BaixarReceber_Click" Background="{StaticResource AccentGreen}" Margin="0,18,0,0" IsEnabled="{Binding PodeOperar}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Auditoria das baixas">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Section}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Auditoria de contas a pagar" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding AuditoriaPagar}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="145" />
                                    <DataGridTextColumn Header="Registro" Binding="{Binding RegistroId}" Width="80" />
                                    <DataGridTextColumn Header="Ação" Binding="{Binding Acao}" Width="90" />
                                    <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Section}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Auditoria de contas a receber" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding AuditoriaReceber}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="145" />
                                    <DataGridTextColumn Header="Registro" Binding="{Binding RegistroId}" Width="80" />
                                    <DataGridTextColumn Header="Ação" Binding="{Binding Acao}" Width="90" />
                                    <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4" Style="{StaticResource Section}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="A pagar: " Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding TotalPagarLabel}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" />
                    <TextBlock Text="   A receber: " Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding TotalReceberLabel}" Foreground="{StaticResource AccentGold}" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
