<Window x:Class="NexumAltivon.Desktop.MapaDesenvolvimentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NexumAltivon.Desktop"
        Title="GenesisGest.Net - Mapa de desenvolvimento WPF/PDV"
        Width="1120"
        Height="760"
        MinWidth="840"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ShellBackground}"
        FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="GOVERNANÇA TÉCNICA" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold" />
                    <TextBlock Text="Mapa de desenvolvimento WPF / PDV" Foreground="{StaticResource TextPrimary}" FontSize="26" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Árvore de menus, janelas e consultas oficialmente vinculadas ao checkout." Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="Versão do assembly" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding ProductVersion}" Foreground="{StaticResource AccentGold}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock Text="Aceite externo: bloqueado até superar 260 tabelas operacionais" Foreground="{StaticResource AccentAmber}" TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Right" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">
            <TreeView ItemsSource="{Binding Nodes}"
                      Background="{StaticResource PanelBackground}"
                      Foreground="{StaticResource TextPrimary}">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type local:DevelopmentMapNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="  " />
                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Border>

        <Border Grid.Row="4"
                Background="{StaticResource PanelSurface}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
            <TextBlock Text="{Binding Evidence}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
