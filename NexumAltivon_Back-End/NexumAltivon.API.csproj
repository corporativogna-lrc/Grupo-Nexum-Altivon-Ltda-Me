<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>NexumAltivon.API</RootNamespace>
    <AssemblyName>NexumAltivon.API</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);API\Legacy\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="API\Program.cs" />
    <Compile Include="API\Data\**\*.cs" />
    <Compile Include="API\ERP\**\*.cs" />
    <Compile Include="API\Infrastructure\**\*.cs" />
    <Compile Include="API\Models\**\*.cs" />
    <Compile Include="API\Services\AssistenteIaService.cs" />
    <Compile Include="API\Services\NotificacaoService.cs" />
    <EmbeddedResource Include="API\Infrastructure\DejaVuSans.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="API\appsettings.json">
      <Link>appsettings.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="API\Database\2026-06-29-genesisgest-original-schema.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Remove="bin\**;obj\**;wwwroot\uploads\**;appsettings.Development.json;appsettings.ERP.json" />
    <None Remove="bin\**;obj\**;wwwroot\uploads\**;appsettings.Development.json;appsettings.ERP.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entity Framework Core -->
    <PackageReference Include="Microsoft.Bcl.Cryptography" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Analyzers" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="10.0.14" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />

    <!-- JWT Authentication -->
    <!-- FluentValidation -->
    <PackageReference Include="FluentValidation" Version="12.2.0" />

    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />

    <!-- BCrypt -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />

    <!-- Health Checks -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.14" />
    <PackageReference Include="System.Formats.Asn1" Version="10.0.14" />
    <PackageReference Include="System.IO.Pipelines" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="System.Text.Encodings.Web" Version="10.0.14" />
    <PackageReference Include="System.Text.Json" Version="10.0.14" />

    <!-- PDF financeiro, MIT, versao fixa e fonte incorporada -->
    <PackageReference Include="PDFsharp" Version="6.5.0" />
  </ItemGroup>

</Project>
